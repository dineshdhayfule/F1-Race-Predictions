  "models": {
    "random_forest": {
      "n_estimators": 500,
      "max_depth": 8,
      "min_samples_leaf": 2,
      "n_jobs": -1
    },
    "xgboost": {
      "n_estimators": 250,
      "final_n_estimators": 250,
      "max_depth": 3,
      "learning_rate": 0.015,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 2,
      "reg_alpha": 1.0,
      "reg_lambda": 2.0,
      "objective": "reg:squarederror"
    },
    "ridge": {
      "alpha": 100.0,
      "random_state": 42
    }
  }
}
