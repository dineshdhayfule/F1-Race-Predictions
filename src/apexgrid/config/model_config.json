{
  "random_seed": 42,
  "ewma_alpha": 0.3,
  "expected_grid_size": 22,
  "monte_carlo": {
    "default_simulations": 10000,
    "precision_simulations": 25000,
    "fallback_sigma": 2.85,
    "fallback_dnf_prob": 0.158,
    "incident_shock_scale": 12.0,
    "stage_sigma_map": {
      "pre_fp1": 3.80,
      "after_fp1": 3.50,
      "after_fp2": 3.10,
      "after_sprint_qualifying": 3.00,
      "after_sprint_race": 2.85,
      "after_fp3": 2.85,
      "after_qualifying": 2.55,
      "before_race": 2.55
    }
  },
  "model_selection": {
    "mode": "multi_model",
    "fixed_rf_weight": 0.6,
    "fixed_xgb_weight": 0.4,
    "promoted_ensemble": {
      "rf_weight": 0.40,
      "xgb_weight": 0.30,
      "ridge_weight": 0.30
    }
  },
  "blending": {
    "ml_weight": 0.65,
    "grid_weight": 0.35,
    "provisional_grid_discount": 0.5,
    "circuit_aware": true,
    "circuit_weights": {
      "street": {
        "grid_weight": 0.50,
        "ml_weight": 0.50
      },
      "permanent": {
        "grid_weight": 0.35,
        "ml_weight": 0.65
      },
      "temporary": {
        "grid_weight": 0.45,
        "ml_weight": 0.55
      },
      "default": {
        "grid_weight": 0.35,
        "ml_weight": 0.65
      }
    }
  },
  "capabilities": {
    "race_pace_intelligence": true,
    "tire_degradation_modeling": false,
    "pit_strategy_simulator": false,
    "race_control_model": true,
    "weather_aware_prediction": false
  },
  "features": [
    "GridPosition",
    "grid_norm",
    "expected_grid_finish",
    "grid_retention_prob",
    "QualifyingPosition",
    "quali_pos_norm",
    "quali_gap_pct",
    "quali_no_time",
    "q1_gap_pct",
    "q2_gap_pct",
    "q3_gap_pct",
    "practice_gap_pct",
    "practice_rank",
    "practice_laps_norm",
    "fp1_gap_pct",
    "fp2_gap_pct",
    "fp3_gap_pct",
    "driver_finish_ewma",
    "driver_quali_ewma",
    "driver_dnf_rate",
    "recent_finish",
    "recent_grid",
    "recent_points",
    "avg_finish",
    "avg_grid",
    "total_points",
    "races_completed",
    "team_finish_ewma",
    "team_points_rate",
    "team_avg_finish",
    "team_points",
    "sprint_finish_pos",
    "sprint_pos_delta",
    "teammate_quali_gap_pct",
    "teammate_grid_delta",
    "driver_teammate_h2h_ratio",
    "is_pit_lane_start",
    "long_run_pace_gap_pct",
    "long_run_pace_rank",
    "race_pace_consistency"
